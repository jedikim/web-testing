{
  "name": "web-agentic-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:acceptance": "vitest run tests/phase-acceptance.test.ts",
    "test:full-flow": "vitest run tests/automation-full-flow.test.ts tests/assistantless-chat-e2e.test.ts tests/phase-acceptance.test.ts",
    "test:e2e:kr": "RUN_KR_E2E=1 vitest run tests/e2e-kr-live.test.ts",
    "test:e2e:kr:headful": "PW_HEADLESS=0 RUN_KR_E2E=1 vitest run tests/e2e-kr-live.test.ts",
    "test:e2e:kr:contract": "vitest run tests/kr-e2e-scenarios.test.ts tests/e2e-kr-live.test.ts",
    "test:e2e:fixtures": "vitest run tests/e2e-fixture-playwright-adapter.test.ts",
    "test:e2e:assistantless:contract": "vitest run tests/assistantless-chat-e2e.test.ts",
    "test:e2e:assistantless:live": "RUN_ASSISTANTLESS_KR_E2E=1 PW_HEADLESS=0 vitest run tests/e2e-assistantless-kr-live.test.ts",
    "test:e2e:chat-ui:headful": "PW_HEADLESS=0 vitest run tests/chat-automation-ui-e2e.test.ts",
    "test:e2e:autonomous:live": "RUN_AUTONOMOUS_BATCH_E2E=1 PW_HEADLESS=0 AUTONOMOUS_BATCH_ROOT=/home/jedi/code/web-agentic-codex/testing/autonomous-batch vitest run tests/e2e-autonomous-batch-kr-live.test.ts",
    "test:provider:contract": "vitest run tests/llm-model-registry.test.ts tests/load-env-file.test.ts tests/provider-matrix-env.test.ts tests/provider-model-matrix.test.ts tests/provider-http-executor.test.ts tests/e2e-provider-matrix-mock.test.ts",
    "test:e2e:provider:live": "RUN_PROVIDER_LIVE_E2E=1 vitest run tests/e2e-provider-live.test.ts",
    "test:evolution": "vitest run tests/evolution-model-policy.test.ts tests/evolution-service.test.ts tests/evolution-server.test.ts",
    "test:sdk": "vitest run tests/auto-improvement-orchestrator.test.ts tests/sdk-automation.test.ts tests/sdk-evolution-api-client.test.ts tests/session-store.test.ts tests/backend-simple-service.test.ts tests/backend-simple-server.test.ts tests/chat-automation-service.test.ts tests/chat-automation-server.test.ts tests/sdk-multiturn.test.ts tests/composite-sheet.test.ts tests/repeated-item-judgement.test.ts",
    "test:v3": "vitest run tests/v3-*.test.ts",
    "test:v3:kr-live": "RUN_KR_E2E=1 vitest run tests/v3-kr-live-harness.test.ts",
    "evolution:server": "tsx src/evolution/server.ts",
    "backend:simple:server": "tsx src/backend/simple-backend-server.ts",
    "backend:chat:server": "tsx src/backend/chat-automation-server.ts",
    "example:sdk:basic": "tsx examples/sdk-basic.ts",
    "example:sdk:auto-improve": "tsx examples/sdk-auto-improvement.ts",
    "example:sdk:multiturn": "tsx examples/sdk-multiturn.ts",
    "example:sdk:human-handoff": "tsx examples/sdk-human-handoff.ts",
    "example:repeated-item": "tsx examples/repeated-item-composite.ts",
    "example:chat-backend": "tsx examples/chat-automation-backend.ts",
    "test:automation": "npm run test:full-flow && npm run test:e2e:kr:contract",
    "test:automation:full": "npm run test:automation && npm run test:provider:contract",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^25.3.2",
    "playwright": "^1.58.2",
    "tsx": "^4.20.6",
    "typescript": "^5.6.3",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@langfuse/otel": "^4.6.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.212.0",
    "@opentelemetry/sdk-trace-node": "^2.5.1",
    "hnswlib-node": "^3.0.0",
    "jimp": "^1.6.0"
  }
}
