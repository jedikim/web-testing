# Runtime execution mode
NODE_ENV=development

# Live KR e2e toggle (1=true, 0=false)
RUN_KR_E2E=0

# Playwright runtime
PW_HEADLESS=1
PLAYWRIGHT_TIMEOUT_MS=20000

# Human-loop safety
HUMAN_LOOP_MAX_TURNS=8

# Artifact output root (relative to repository root)
ARTIFACT_ROOT=runs/samples/artifacts

# LLM integration (optional; external assistant project may own this)
LLM_ENABLED=0
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
