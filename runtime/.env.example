# Runtime execution mode
NODE_ENV=development

# Live E2E tests auto-load runtime/.env (and fallback .env) before reading process.env

# Live KR e2e toggle (1=true, 0=false)
RUN_KR_E2E=0
RUN_PROVIDER_LIVE_E2E=0
RUN_ASSISTANTLESS_KR_E2E=0
ASSISTANTLESS_KR_ITERATIONS=1
RUN_AUTONOMOUS_BATCH_E2E=0
AUTONOMOUS_BATCH_ITERATIONS=2
AUTONOMOUS_BATCH_ROOT=/home/jedi/code/web-agentic-codex/testing/autonomous-batch

# Playwright runtime (headful testing: 0)
PW_HEADLESS=0
PLAYWRIGHT_TIMEOUT_MS=20000

# Human-loop safety
HUMAN_LOOP_MAX_TURNS=8

# Artifact output root (relative to repository root)
ARTIFACT_ROOT=runs/samples/artifacts

# LLM runtime (single provider selection path)
LLM_ENABLED=0
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=
LLM_MODEL_OPTIONS=
LLM_BASE_URL=

# Provider-specific optional overrides for single-provider mode
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.1-pro-preview,gemini-3.0-flash,gemini-2.0-flash
GEMINI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODELS=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODELS=
ANTHROPIC_BASE_URL=

# Multi-vendor provider matrix (for e2e-provider-live)
LLM_VENDOR_ORDER=gemini,openai,anthropic

# YOLO26 matrix settings
YOLO26_ENABLED=0
# local open-source YOLO26 endpoint can run without API key
YOLO26_API_KEY=
YOLO26_BASE_URL=
YOLO26_MODELS=yolo26n,yolo26s

# Evolution backend (bug/exception growth loop)
EVOLUTION_SERVER_HOST=127.0.0.1
EVOLUTION_SERVER_PORT=4777
EVOLUTION_REPO_ROOT=
EVOLUTION_STATE_ROOT=/home/jedi/code/web-agentic-codex/testing/evolution/state
EVOLUTION_BASE_BRANCH=main
EVOLUTION_TEST_COMMAND=npm run test:automation:full
EVOLUTION_MAX_AUTOFIX_ATTEMPTS=2
EVOLUTION_TEST_TIMEOUT_MS=600000
EVOLUTION_CODING_MODEL=gemini-3.1-pro-preview
EVOLUTION_AUTOMATION_MODEL=gemini-3.0-flash
EVOLUTION_AUTOFIX_ENABLED=0
EVOLUTION_PROMOTE_MODE=pointer

# Backend simple mode (session-based chat automation backend)
BACKEND_SERVER_HOST=127.0.0.1
BACKEND_SERVER_PORT=4888
BACKEND_SESSION_ROOT=/home/jedi/code/web-agentic-codex/testing/backend/state
# 1: use Gemini for session response generation, 0: rule-based fallback only
BACKEND_LLM_ENABLED=0
BACKEND_AUTOMATION_MODEL=gemini-3.0-flash
# Legal-safe policy: captcha/2FA/security challenge bypass automation is disabled; use human handoff.

# Chat automation example backend (chat + runtime progress + captcha handoff demo)
CHAT_AUTOMATION_SERVER_HOST=127.0.0.1
CHAT_AUTOMATION_SERVER_PORT=4999
CHAT_AUTOMATION_SESSION_ROOT=/home/jedi/code/web-agentic-codex/testing/chat-automation/state
CHAT_AUTOMATION_UPLOAD_ROOT=/home/jedi/code/web-agentic-codex/testing/chat-automation/state/uploads
