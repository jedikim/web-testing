# Runtime execution mode
NODE_ENV=development

# Live E2E tests auto-load runtime/.env (and fallback .env) before reading process.env

# Live KR e2e toggle (1=true, 0=false)
RUN_KR_E2E=0
RUN_PROVIDER_LIVE_E2E=0
RUN_ASSISTANTLESS_KR_E2E=0
ASSISTANTLESS_KR_ITERATIONS=1
RUN_AUTONOMOUS_BATCH_E2E=0
AUTONOMOUS_BATCH_ITERATIONS=2
AUTONOMOUS_BATCH_ROOT=/home/jedi/code/web-agentic-codex/testing/autonomous-batch

# Playwright runtime (headful testing: 0)
PW_HEADLESS=0
PLAYWRIGHT_TIMEOUT_MS=20000

# Human-loop safety
HUMAN_LOOP_MAX_TURNS=8

# Selector self-healing fallback
SIMILO_ENABLED=1

# Artifact output root (relative to repository root)
ARTIFACT_ROOT=runs/samples/artifacts

# LLM runtime (single provider selection path)
LLM_ENABLED=0
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=
LLM_MODEL_OPTIONS=
LLM_BASE_URL=

# Provider-specific optional overrides for single-provider mode
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.1-pro-preview,gemini-3-flash-preview
# leave empty for default official endpoint (https://generativelanguage.googleapis.com/v1beta)
# DO NOT set this to LANGFUSE_BASE_URL
GEMINI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODELS=gpt-5-codex,gpt-5-mini
OPENAI_BASE_URL=
# Explicit model split policy:
# - automation/runtime: low-cost models (flash/mini)
# - coding/autofix: high-capability models (pro/codex)
BACKEND_AUTOMATION_GEMINI_MODEL=gemini-3-flash-preview
BACKEND_AUTOMATION_OPENAI_MODEL=gpt-5-mini

# Multi-vendor provider matrix (for e2e-provider-live)
# runtime/planner also follows this order exactly.
# use `gemini` for gemini-only execution.
LLM_VENDOR_ORDER=gemini,openai

# RFDETR matrix settings
RFDETR_ENABLED=0
# local open-source RFDETR endpoint can run without API key
RFDETR_API_KEY=
RFDETR_BASE_URL=
RFDETR_MODELS=rf-detr-medium
# local command mode (recommended for self-hosted rfdetr open-source)
# command should read JSON from stdin and print JSON with `detections` array
# example: python3 scripts/rfdetr_local.py
RFDETR_LOCAL_COMMAND=
RFDETR_LOCAL_TIMEOUT_MS=45000

# Evolution backend (bug/exception growth loop)
EVOLUTION_SERVER_HOST=127.0.0.1
EVOLUTION_SERVER_PORT=4777
EVOLUTION_REPO_ROOT=
EVOLUTION_STATE_ROOT=/home/jedi/code/web-agentic-codex/testing/evolution/state
EVOLUTION_BASE_BRANCH=main
EVOLUTION_TEST_COMMAND=npm run test:automation:full
EVOLUTION_MAX_AUTOFIX_ATTEMPTS=2
EVOLUTION_TEST_TIMEOUT_MS=600000
EVOLUTION_CODING_MODEL=gemini-3.1-pro-preview
EVOLUTION_AUTOMATION_MODEL=gemini-3-flash-preview
EVOLUTION_AUTOFIX_ENABLED=0
EVOLUTION_PROMOTE_MODE=pointer

# Backend simple mode (session-based chat automation backend)
BACKEND_SERVER_HOST=127.0.0.1
BACKEND_SERVER_PORT=4888
BACKEND_SESSION_ROOT=/home/jedi/code/web-agentic-codex/testing/backend/state
# 1: use Gemini for session response generation, 0: rule-based fallback only
BACKEND_LLM_ENABLED=0
BACKEND_AUTOMATION_MODEL=gemini-3-flash-preview
BACKEND_CASCADE_ESCALATION_MODEL=gemini-3.1-pro-preview
BACKEND_CASCADE_THRESHOLD=0.65
PLAN_CACHE_ENABLED=1
PLAN_CACHE_SIMILARITY_THRESHOLD=0.45
# Legal-safe policy: captcha/2FA/security challenge bypass automation is disabled; use human handoff.

# Chat automation example backend (chat + runtime progress + captcha handoff demo)
CHAT_AUTOMATION_SERVER_HOST=127.0.0.1
CHAT_AUTOMATION_SERVER_PORT=4999
CHAT_AUTOMATION_SESSION_ROOT=/home/jedi/code/web-agentic-codex/testing/chat-automation/state
CHAT_AUTOMATION_UPLOAD_ROOT=/home/jedi/code/web-agentic-codex/testing/chat-automation/state/uploads
# execution mode: playwright | simulate
CHAT_AUTOMATION_EXECUTION_MODE=playwright
# planner mode: llm_first | rule_first
CHAT_AUTOMATION_PLANNER_MODE=llm_first
# default 0: automation uses flash tier only (recommended)
# set 1 only when you explicitly want runtime escalation to pro tier
CHAT_AUTOMATION_ALLOW_PRO_ESCALATION=0
# max listing strategy retries per run (1~8)
CHAT_AUTOMATION_MAX_PLANNER_ATTEMPTS=4
# max planner actions accepted from LLM per attempt
CHAT_AUTOMATION_MAX_PLANNER_ACTIONS=18
# strict menu-first tasks defer in-site search fallback until this attempt (2~6)
CHAT_AUTOMATION_SEARCH_FALLBACK_START_ATTEMPT=3
# max intra-action category traversal hops for hint_navigate (3~12)
CHAT_AUTOMATION_HINT_MAX_PATH_STEPS=7
# per hint_navigate action hop budget (leave empty for dynamic budget based on hint depth)
CHAT_AUTOMATION_HINT_HOPS_PER_ACTION=
# max candidate checks per hop in hint_navigate (20~120)
CHAT_AUTOMATION_HINT_MAX_CANDIDATE_CHECKS=44
# strict menu-first flow opens filter/search only after enough hint-navigation evidence
CHAT_AUTOMATION_MIN_HINT_SIGNALS_FOR_CONTEXT=4
# optional DOM-ROI VLM rerank for navigation candidates (0=off, 1=on)
CHAT_AUTOMATION_NAV_VLM_ENABLED=0
# repeated-item visual analysis (thumbnail grid -> rfdetr) for listing constraints
CHAT_AUTOMATION_VISUAL_REPEAT_ENABLED=1
CHAT_AUTOMATION_VISUAL_TILE_LIMIT=24
# candidate reduction pipeline (structure-first -> optional semantic rerank)
CHAT_AUTOMATION_SEMANTIC_RERANK_ENABLED=1
# semantic rerank is used only when candidate count is large enough
CHAT_AUTOMATION_SEMANTIC_RERANK_MIN_CANDIDATES=24
# structure-first pool size (DOM -> reduced candidate pool)
CHAT_AUTOMATION_STRUCTURE_FIRST_LIMIT=50
# top candidates returned to action executor after reduction/rerank
CHAT_AUTOMATION_MAX_REDUCED_CANDIDATES=8
# vector backend for in-memory ANN: auto | hnsw | bruteforce
CHAT_AUTOMATION_VECTOR_BACKEND=auto
CHAT_AUTOMATION_RUNTIME_SCREENSHOT_ROOT=/home/jedi/code/web-agentic-codex/testing/chat-automation/runtime-shots

# Optional Langfuse tracing (0=off, 1=on)
LANGFUSE_ENABLED=0
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
LANGFUSE_ENV=development
LANGFUSE_RELEASE=
LANGFUSE_TIMEOUT_SECONDS=10

# optional per-provider escalation model split for planner cascade
BACKEND_CASCADE_ESCALATION_GEMINI_MODEL=gemini-3.1-pro-preview
BACKEND_CASCADE_ESCALATION_OPENAI_MODEL=gpt-5-codex
