# Runtime execution mode
NODE_ENV=development

# Live E2E tests auto-load runtime/.env (and fallback .env) before reading process.env

# Live KR e2e toggle (1=true, 0=false)
RUN_KR_E2E=0
RUN_PROVIDER_LIVE_E2E=0

# Playwright runtime
PW_HEADLESS=1
PLAYWRIGHT_TIMEOUT_MS=20000

# Human-loop safety
HUMAN_LOOP_MAX_TURNS=8

# Artifact output root (relative to repository root)
ARTIFACT_ROOT=runs/samples/artifacts

# LLM runtime (single provider selection path)
LLM_ENABLED=0
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=
LLM_MODEL_OPTIONS=
LLM_BASE_URL=

# Provider-specific optional overrides for single-provider mode
GEMINI_API_KEY=
GEMINI_MODELS=
GEMINI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODELS=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODELS=
ANTHROPIC_BASE_URL=

# Multi-vendor provider matrix (for e2e-provider-live)
LLM_VENDOR_ORDER=gemini,openai,anthropic

# YOLO26 matrix settings
YOLO26_ENABLED=0
YOLO26_API_KEY=
YOLO26_BASE_URL=
YOLO26_MODELS=yolo26n,yolo26s
